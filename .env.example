# === drum.ai — скопируй в .env и заполни ===

# Сервер
PORT=3000
NODE_ENV=development
APP_NAME=drum.ai
BASE_URL=http://localhost:3000

# OpenRouter (чат)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-small-3.1-24b-instruct

# Google OAuth (вход) — после смены ключей перезапусти: npm start
# Ошибка deleted_client = старый клиент удалён → создай НОВЫЙ OAuth Client ID в Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Если redirect_uri_mismatch — укажи точный URL (как в Google Console):
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Render: BASE_URL не нужен — подставится RENDER_EXTERNAL_URL
# Google Console → OAuth consent screen → App name = drum.ai
# Redirect URI: https://ТВОЙ-ДОМЕН.onrender.com/auth/google/callback
